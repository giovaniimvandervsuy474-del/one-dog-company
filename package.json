{
  "name": "one-dog-company",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false --ignore \"chronicle/**\" --ignore \"config/**\" server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@monaco-editor/react": "4.7.0",
    "@react-three/drei": "10.7.6",
    "@react-three/fiber": "9.3.0",
    "@react-three/postprocessing": "^3.0.4",
    "@solana/web3.js": "^1.98.4",
    "@xyflow/react": "12.8.6",
    "playwright-core": "^1.56.1",
    "postprocessing": "^6.37.8",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0",
    "zod": "4.1.11",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/node": "24.6.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  }
}
